#!/usr/bin/env python3
"""Ask Will for one judgement and (optionally) block until he answers.

The producer gate for any agent on the LAN: post a question with bounded
evidence to the judgement queue, and with ``--wait`` poll until the answer
arrives, printing it to stdout. Exit 0 with the answer; exit 2 on expiry
(the third outcome — nothing defaults to yes); exit 3 on ``--timeout``.

Evidence discipline (learned the hard way): a card whose answer destroys
something leads with what is destroyed and what is unique about it; state
facts as of now, not as of when you last looked; prefer the short default
expiry over a long one — a question worth days of waiting is worth re-asking
with fresh evidence.

stdlib only, so it installs anywhere. $MDJUDGE_URL overrides the service
(default the lovelace front door); TLS is unverified while the intranet CA
remains a browser-side install — the bearer seal replaces this posture.
"""

import argparse
import json
import os
import socket
import ssl
import sys
import time
import urllib.error
import urllib.request

BASE = os.environ.get("MDJUDGE_URL", "https://lovelace.fritz.box/judge")
CONTEXT = ssl._create_unverified_context()


def call(method, path, payload=None):
    request = urllib.request.Request(
        f"{BASE}/api/{path}",
        method=method,
        data=json.dumps(payload).encode() if payload is not None else None,
        headers={"Content-Type": "application/json"},
    )
    with urllib.request.urlopen(request, context=CONTEXT, timeout=30) as response:
        return json.load(response)


def main():
    parser = argparse.ArgumentParser(description="ask Will for one judgement")
    parser.add_argument("title", help="the question, phrased to be read aloud")
    parser.add_argument("--summary", help="one-line form (default: the title)")
    parser.add_argument("--evidence", default="", help="markdown evidence body")
    parser.add_argument(
        "--evidence-file", help="read the evidence body from a file ('-' = stdin)"
    )
    parser.add_argument(
        "--option", action="append", default=[], help="an offered answer (repeatable)"
    )
    parser.add_argument("--interrupt", choices=("open", "brief"), default="brief")
    parser.add_argument(
        "--producer",
        default=os.environ.get(
            "MDJUDGE_PRODUCER", f"{os.environ.get('USER', 'agent')}@{socket.gethostname()}"
        ),
    )
    parser.add_argument("--expires-hours", type=float, help="override the service TTL")
    parser.add_argument("--wait", action="store_true", help="block until answered")
    parser.add_argument("--poll", type=float, default=20, help="seconds between polls")
    parser.add_argument("--timeout", type=float, help="give up waiting after seconds")
    args = parser.parse_args()

    evidence = args.evidence
    if args.evidence_file:
        evidence = (
            sys.stdin.read()
            if args.evidence_file == "-"
            else open(args.evidence_file).read()
        )
    payload = {
        "title": args.title,
        "summary": args.summary or args.title,
        "evidence": evidence,
        "options": args.option,
        "interrupt": args.interrupt,
        "producer": args.producer,
    }
    if args.expires_hours is not None:
        from datetime import datetime, timedelta, timezone

        payload["expires"] = (
            datetime.now(timezone.utc) + timedelta(hours=args.expires_hours)
        ).isoformat(timespec="seconds")

    try:
        posted = call("POST", "request", payload)
    except urllib.error.HTTPError as error:
        sys.exit(f"mdjudge-ask: {error.code}: {error.read().decode()}")
    print(f"mdjudge-ask: posted {posted['id']}", file=sys.stderr)
    if not args.wait:
        print(posted["id"])
        return 0

    deadline = time.monotonic() + args.timeout if args.timeout else None
    while True:
        verdict = call("GET", f"request/{posted['id']}")
        if verdict["status"] == "answered":
            print(verdict["answer"])
            return 0
        if verdict["status"] != "open":
            print(f"mdjudge-ask: {verdict['status']} without an answer", file=sys.stderr)
            return 2
        if deadline and time.monotonic() > deadline:
            print(f"mdjudge-ask: still open after timeout; id {posted['id']}", file=sys.stderr)
            return 3
        time.sleep(args.poll)


if __name__ == "__main__":
    sys.exit(main())
